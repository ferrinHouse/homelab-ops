# Tail of /etc/fstab on pinas: the NVMe and the NFS export bind mounts. Not deployed by CI; edit
# /etc/fstab by hand to match, then: sudo systemctl daemon-reload && sudo mount -a
UUID=be77ee55-2852-4994-ae9f-26b76de17318  /mnt/nvme1  ext4  defaults,noatime,nofail  0  2
# NFS export binds: /mnt/nvme1/shares/<name> -> /export/<name> (record: hosts/pinas/fstab-export-binds)
/mnt/nvme1/shares/ferrinMedia  /export/ferrinMedia  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/plex-config  /export/plex-config  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/mealie-data  /export/mealie-data  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/npm-data  /export/npm-data  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/whiskey-db  /export/whiskey-db  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/whiskey-photos  /export/whiskey-photos  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/whiskey-app  /export/whiskey-app  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
/mnt/nvme1/shares/KubernetesLogs  /export/KubernetesLogs  none  bind,nofail,x-systemd.requires-mounts-for=/mnt/nvme1  0  0
